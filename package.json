{
  "name": "stykanimate-mcp",
  "version": "0.1.0",
  "description": "An MCP server that reads, inspects and edits StykAnimate and Pivot stick figure animations.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "stykanimate-mcp": "src/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js"
  },
  "files": [
    "assets/",
    "src/",
    "vendor/stykanimate/",
    "py/",
    "README.md",
    "llms.txt",
    "server.json",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/index.js --transport http --port 7331",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "vendor": "node scripts/vendor-sync.mjs",
    "vendor:check": "node scripts/vendor-sync.mjs --check",
    "bundle": "node scripts/build-mcpb.mjs",
    "demo": "node scripts/demo-session.mjs",
    "prepublishOnly": "npm run check && npm test",
    "publish:package": "npm publish --access public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "animation",
    "stick-figure",
    "pivot",
    "stykanimate"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghassenTn/stykanimate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ghassenTn/stykanimate-mcp/issues"
  },
  "homepage": "https://stykanimate.com",
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.10"
  }
}
