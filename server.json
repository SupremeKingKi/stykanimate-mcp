{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.ghassentn/stykanimate-mcp",
  "description": "Read, inspect and edit StykAnimate and Pivot stick figure animations.",
  "version": "0.1.0",
  "status": "active",
  "website_url": "https://stykanimate.com",
  "repository": {
    "url": "https://github.com/ghassenTn/stykanimate-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registry_type": "npm",
      "registry_base_url": "https://registry.npmjs.org",
      "identifier": "stykanimate-mcp",
      "version": "0.1.0",
      "runtime_hint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtime_arguments": [
        {
          "type": "named",
          "name": "-y",
          "value": "-y"
        }
      ],
      "package_arguments": [
        {
          "type": "positional",
          "value_hint": "package",
          "value": "stykanimate-mcp"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "runtime": {
        "node": ">=20.0.0"
      },
      "optionalDependencies": {
        "python": "3.10 or newer, only needed to read and write Pivot .piv and .stk files"
      }
    }
  }
}
